# Copy to .env and fill in. `make run-web` / `make run` auto-load it.
# Never commit the real .env.

# --- Production: Azure Key Vault (recommended) ---
# When set, ALL secrets below AND the full config (the `app-config` secret) are
# pulled from Key Vault at startup via Workload Identity / Managed Identity, so
# you don't need to set them here. Leave unset for local dev with this .env.
# AZURE_KEY_VAULT_URL=https://finops-kv.vault.azure.net/
# KEY_VAULT_REQUIRED=true        # fail fast if the vault can't be read
# APP_ENV=production             # enables secure (HTTPS-only) session cookies
# Populate the vault from this file + config.yaml:
#   ./scripts/setup-keyvault.sh finops-kv .env config/config.yaml

# --- Web app login ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
# Required when APP_ENV=production. Locally falls back to BASIC_AUTH_PASSWORD.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Config path (ignored when the `app-config` secret is in Key Vault) ---
CONFIG_PATH=config/config.yaml

# --- Enable/disable each cost source's collection ---
# Accepts true/false (also 1/0, yes/no, on/off).
AWS_ENABLED=true
AZURE_ENABLED=true
GCP_ENABLED=true
# LLM / AI spend sources (safe to leave enabled — they no-op without a key).
CURSOR_ENABLED=true
ANTHROPIC_ENABLED=true

# --- Database (Azure Database for PostgreSQL) ---
# Reports + history are stored here. Required for the web app and persisted runs.
# password mode (local/dev):
#   postgresql://ccruser:PASS@postgres.example.database.azure.com/costreporter?sslmode=require
# entra mode (in-cluster, passwordless): set DB_AUTH=entra and use the identity
#   name as the user, no password:
#   postgresql://cloud-cost-reporter@postgres.example.database.azure.com/costreporter?sslmode=require
DATABASE_URL=
DB_AUTH=password

# --- AWS (read-only Cost Explorer) ---
# Option 1 (local): use a named profile from ~/.aws (boto3 honors AWS_PROFILE).
AWS_PROFILE=default
# Option 2 (in-cluster): static read-only key instead of a profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only if using temporary creds
AWS_DEFAULT_REGION=us-east-1

# --- Azure ---
# Local option 1: run `az login` (DefaultAzureCredential uses your CLI session).
# Local option 2 / non-interactive: service principal from
#   scripts/setup-azure-principal.sh (EnvironmentCredential picks these up).
# In-cluster: prefer Workload Identity (federated, no secret).
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000001
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- GCP (read-only billing) ---
# Historical months are read from Console "Cost table" CSVs in gcp-billing/.
# The forward-looking BigQuery export path uses a service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-cost-reporter-key.json
# Or provide the key inline (e.g. from Key Vault) instead of a file:
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Cursor (LLM / coding-assistant spend, read-only Admin API) ---
# Team/Admin API key: Cursor > Dashboard > Settings > Cursor Admin API keys.
# This is an ADMIN key (used with `-u KEY:`), NOT a per-developer model key.
CURSOR_API_KEY=

# --- Anthropic / Claude (LLM API spend, read-only Admin API) ---
# Admin API key (sk-ant-admin01-...) from the Claude Console > Settings > Admin
# keys. This is DIFFERENT from the sk-ant-api... keys used to call the models.
ANTHROPIC_ADMIN_KEY=

# Note on Google/Gemini: Gemini + Vertex AI spend is billed through Google Cloud,
# so it is already captured by the GCP collector above (as the "Generative
# Language API" / "Vertex AI" service lines). Make sure the billing project that
# backs your Gemini API keys is included under `gcp.bigquery` in config.yaml.

# --- Email via Azure Communication Services (ACS) ---
# Master switch for email delivery (true/false). Overrides config + CLI default.
EMAIL_ENABLED=true
# Option 1: connection string (the access key — keep it secret / in Key Vault).
ACS_CONNECTION_STRING=
# Option 2 (passwordless): the ACS resource endpoint, used with Managed Identity.
# ACS_ENDPOINT=https://acs.example.communication.azure.com
# Sender + receiver(s) are set in config.yaml (email.sender / email.recipients).
